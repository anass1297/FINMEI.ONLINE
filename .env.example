# Database — SQLite for local dev. For production use PostgreSQL:
#   change provider in prisma/schema.prisma to "postgresql" and set
#   DATABASE_URL="postgresql://user:pass@host:5432/kontora"
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"

# Google OAuth (optional — the Google button only shows when both are set)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email (optional). Without SMTP, emails are printed to the server console.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="FINMEI Financial <no-reply@finmei.online>"

# Require email verification before credential login
REQUIRE_EMAIL_VERIFICATION="true"

# Protects /api/cron/recurring (call it daily from your scheduler)
CRON_SECRET="replace-with-random-string"

# Local file storage for receipts/attachments
UPLOAD_DIR="./uploads"

# Future payment providers (not active yet — see src/lib/payments/providers)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
USD_TO_MAD="10"
